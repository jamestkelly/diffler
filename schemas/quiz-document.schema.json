                        }
                      ],
                      "description": "Repository-relative file path"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["path", "startLine", "endLine"],
                  "additionalProperties": false
                }
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "feedback": {
                "type": "object",
                "properties": {
                  "whenRight": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "whenWrong": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["whenRight", "whenWrong"],
                "additionalProperties": false
              },
              "correctAnswers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "id",
              "prompt",
              "required",
              "points",
              "sources",
              "options",
              "feedback",
              "correctAnswers"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "dropdown"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "required": {
                "type": "boolean"
              },
              "points": {
                "type": "integer",

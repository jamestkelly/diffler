                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["whenRight", "whenWrong"],
                "additionalProperties": false
              },
              "correctAnswers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "id",
              "prompt",
              "required",
              "points",
              "sources",
              "options",
              "feedback",
              "correctAnswers"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "short_answer"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "required": {
                "type": "boolean"
              },
              "points": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2147483647
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "allOf": [
                        {
                          "pattern": "\\S"
                        },
                        {
                          "pattern": "^(?!\\/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[\\\\/]$).+$"
                        }
                      ],
                      "description": "Repository-relative file path"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["path", "startLine", "endLine"],
                  "additionalProperties": false
                }
              },
              "correctAnswers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "feedback": {
                "type": "object",
                "properties": {
                  "general": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["general"],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "id",
              "prompt",
              "required",
              "points",
              "sources",
              "correctAnswers",
              "feedback"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "baseRef",
    "headSha",
    "diffHash",
    "title",
    "questions"
  ],
  "additionalProperties": false,
  "description": "A validated Diffler quiz document",
  "x-diffler-runtime-validations": [
    "Source endLine must be greater than or equal to startLine",
    "Every correct answer for a choice question must match an option",
    "Question IDs must be unique within the document"
  ]
}

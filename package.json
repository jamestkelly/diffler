{
  "name": "@jamestkelly/diffler",
  "version": "0.0.0",
  "description": "Generate comprehension quizzes from Git branch diffs for Claude Code, OpenCode, and pull-request workflows.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "diffler": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "cloud:check": "tsx scripts/cloud-check.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "oauth:inject": "tsx scripts/inject-google-oauth-client.ts",
    "schema:write": "tsx scripts/write-quiz-schema.ts",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "google-auth-library": "10.9.1",
    "open": "11.0.0",
    "zod": "4.4.3"
  }
}

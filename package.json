{
  "name": "@diffler/cli",
  "version": "0.0.0",
  "description": "Generate comprehension quizzes from Git branch diffs for Claude Code, OpenCode, and pull-request workflows.",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamestkelly/diffler.git"
  },
  "homepage": "https://github.com/jamestkelly/diffler#readme",
  "bugs": {
    "url": "https://github.com/jamestkelly/diffler/issues"
  },
  "keywords": [
    "code-review",
    "git",
    "google-forms",
    "quiz",
    "claude-code",
    "opencode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs/diff-context.md",
    "docs/google-auth.md",
    "docs/google-forms-publishing.md",
    "docs/npm-publication.md",
    "docs/quiz-document.md",
    "docs/repository-settings.md",
    "docs/skill-installation.md",
    "schemas/quiz-document.schema.json",
    "skills/diffler/SKILL.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "diffler": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "cloud:check": "tsx scripts/cloud-check.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "package:smoke": "tsx scripts/package-smoke.ts",
    "prepack": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm schema:check && pnpm clean && pnpm build",
    "schema:check": "tsx scripts/check-quiz-schema.ts",
    "schema:write": "tsx scripts/write-quiz-schema.ts",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "google-auth-library": "10.9.1",
    "open": "11.0.0",
    "zod": "4.4.3"
  }
}
